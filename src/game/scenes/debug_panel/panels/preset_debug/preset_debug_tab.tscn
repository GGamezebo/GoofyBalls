[gd_scene format=3]

[ext_resource type="Script" path="res://src/game/scenes/debug_panel/panels/preset_debug/preset_debug_tab.gd" id="1_tab"]
[ext_resource type="PackedScene" path="res://src/game/scenes/debug_panel/panels/preset_debug/preset_field_row.tscn" id="2_row"]
[ext_resource type="PackedScene" path="res://src/game/scenes/debug_panel/panels/preset_debug/preset_group_label.tscn" id="3_group"]

[node name="PresetDebugTab" type="VBoxContainer" node_paths=PackedStringArray("enabled_toggle", "reset_button", "note_label", "fields_box")]
theme_override_constants/separation = 8
script = ExtResource("1_tab")
enabled_toggle = NodePath("Header/Enabled")
reset_button = NodePath("Header/Reset")
note_label = NodePath("Note")
fields_box = NodePath("Scroll/Fields")
row_template = ExtResource("2_row")
group_template = ExtResource("3_group")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Enabled" type="CheckButton" parent="Header"]
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
theme_override_font_sizes/font_size = 22
text = "Включено"

[node name="Reset" type="Button" parent="Header"]
layout_mode = 2
focus_mode = 0
theme_type_variation = &"GhostButton"
theme_override_font_sizes/font_size = 20
text = "Сбросить"

[node name="Note" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 18
autowrap_mode = 3

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Fields" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4
