[gd_scene format=3]

[ext_resource type="Script" path="res://src/game/scenes/debug_panel/panels/config_debug/config_debug_tab.gd" id="1_tab"]
[ext_resource type="PackedScene" path="res://src/game/scenes/debug_panel/panels/config_debug/config_editor.tscn" id="2_ed"]
[ext_resource type="Script" path="res://src/game/scenes/debug_panel/panels/config_debug/debug_config_def.gd" id="3_def"]
[ext_resource type="Resource" uid="uid://bws6072ermmkq" path="res://src/common/presets/physics_classic.tres" id="4_ph"]
[ext_resource type="Resource" path="res://src/common/presets/arena_s.tres" id="5_ar"]
[ext_resource type="Resource" path="res://src/common/presets/rules_points_7.tres" id="6_ru"]

[sub_resource type="Resource" id="Resource_physics"]
script = ExtResource("3_def")
title = "Физика"
config = ExtResource("4_ph")
sim_section = "physics"
save_note = "На этом конфиге стоит тест детерминизма: после сохранения обнови expected_hash в determinism_probe.tres (тест выведет новый хеш)."

[sub_resource type="Resource" id="Resource_arena"]
script = ExtResource("3_def")
title = "Арена"
config = ExtResource("5_ar")
sim_section = "arena"
save_note = "На этом конфиге стоит тест детерминизма: после сохранения обнови expected_hash в determinism_probe.tres (тест выведет новый хеш)."

[sub_resource type="Resource" id="Resource_rules"]
script = ExtResource("3_def")
title = "Правила"
config = ExtResource("6_ru")
sim_section = "rules"
save_note = "На этом конфиге стоит тест детерминизма: после сохранения обнови expected_hash в determinism_probe.tres (тест выведет новый хеш)."

[node name="ConfigDebugTab" type="VBoxContainer" node_paths=PackedStringArray("config_tabs")]
theme_override_constants/separation = 8
script = ExtResource("1_tab")
configs = Array[ExtResource("3_def")]([SubResource("Resource_physics"), SubResource("Resource_arena"), SubResource("Resource_rules")])
config_tabs = NodePath("Configs")
editor_template = ExtResource("2_ed")

[node name="Hint" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 18
text = "Конфиги игры — значения по умолчанию из .tres. «Включено» — попробовать в игре, «Сохранить» — сделать новым дефолтом."
autowrap_mode = 3

[node name="Configs" type="TabContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 20
